{
  "name": "mustbeviral",
  "description": "Cloudflare-native multi-brand AI marketing autopilot built with React Router, Hono, Workers, D1, Durable Objects, Workflows, and R2",
  "cloudflare": {
    "label": "React Router + Hono Fullstack App",
    "products": [
      "Workers"
    ],
    "categories": [
      "starter"
    ],
    "docs_url": "https://developers.cloudflare.com/workers",
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/d3db20ee-c3bf-4b5c-f1ed-d86021359e00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/56caa8a9-d3ab-4ac6-32a9-6a5fc686e000/preview",
    "publish": true
  },
  "dependencies": {
    "hono": "4.11.1",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@react-router/dev": "7.9.6",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.3.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "tailwindcss": "4.1.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "6.4.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.5",
    "wrangler": "4.90.0"
  },
  "private": true,
  "scripts": {
    "build": "react-router build",
    "bootstrap:cf": "tsx scripts/cf-bootstrap.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mustbeviral --local",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b"
  },
  "type": "module"
}
