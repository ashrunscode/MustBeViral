{
  "name": "mustbeviral-studio",
  "version": "0.0.0",
  "private": true,
  "description": "MustBeViral Studio and the ViralGraph creative execution engine.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "agent:preflight": "node governance/scripts/preflight.mjs",
    "agent:start": "node governance/scripts/agent-state.mjs start",
    "agent:verify": "node governance/scripts/agent-state.mjs verify",
    "agent:handoff": "node governance/scripts/agent-state.mjs handoff",
    "agent:finish": "node governance/scripts/agent-state.mjs finish",
    "agent:recover": "node governance/scripts/agent-state.mjs recover",
    "packet:verify": "node governance/scripts/validate-work-packet.mjs",
    "diff-scope:check": "node governance/scripts/validate-diff-scope.mjs",
    "design:check": "node governance/scripts/validate-design-direction.mjs",
    "transition:check": "node governance/scripts/validate-transition-receipts.mjs",
    "docs:generate": "node governance/scripts/generate-docs.mjs",
    "docs:check": "node governance/scripts/validate-docs.mjs",
    "cleanroom:check": "node governance/scripts/scan-cleanroom.mjs",
    "generated:check": "node governance/scripts/check-generated.mjs",
    "task-graph:check": "node governance/scripts/validate-task-graph.mjs",
    "governance:check": "pnpm docs:check && pnpm packet:verify && pnpm transition:check && pnpm cleanroom:check && pnpm generated:check",
    "governance:test": "node --test governance/tests/**/*.test.mjs",
    "format:check": "prettier --check .",
    "security:check": "pnpm cleanroom:check",
    "lint:governance": "eslint governance/**/*.mjs --max-warnings=0",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --concurrency=50%",
    "test": "turbo run test --concurrency=50% --filter=!@mustbeviral/core && turbo run test --concurrency=1 --filter=@mustbeviral/core",
    "test:integration": "turbo run test:integration --filter=!@mustbeviral/core && turbo run test:integration --concurrency=1 --filter=@mustbeviral/core",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build --concurrency=50%",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "db:types": "pnpm --filter @mustbeviral/db generate:types",
    "verify": "pnpm format:check && pnpm governance:check && pnpm governance:test && pnpm security:check && pnpm task-graph:check && pnpm lint:governance && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/inspector": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.61.1",
    "@superdesign/cli": "0.4.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "8.17.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "markdown-link-check": "3.13.7",
    "micromatch": "4.0.8",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vercel": "55.0.0",
    "vitest": "4.1.10",
    "wrangler": "4.110.0",
    "yaml": "2.8.1"
  }
}
