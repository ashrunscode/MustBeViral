{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mustbeviral-v2-development-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SERVICE_NAME": "mustbeviral-core",
    "SERVICE_GENERATION": "viralgraph-cleanroom-v2",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "mustbeviral-v2-development-media",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "staging": {
      "name": "mustbeviral-v2-staging-core",
      "workers_dev": true,
      "vars": {
        "SERVICE_NAME": "mustbeviral-core",
        "SERVICE_GENERATION": "viralgraph-cleanroom-v2",
        "APP_ENV": "staging",
        "SUPABASE_URL": "https://lqvigvzqumpwfjikcvws.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_L06t0Y52MPKmhWtAHXm3FQ_2_b0-lMb",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "mustbeviral-v2-staging-media",
        },
      ],
      // Hyperdrive binding intentionally absent in staging: P0 uses the Supabase Data API
      // unless the accepted G1-G6 Hyperdrive benchmark passes (rls-hyperdrive-benchmark-plan).
      // The api-staging.mustbeviral.com custom domain attaches once the zone lands in this account.
    },
    "production": {
      "name": "mustbeviral-v2-production-core",
      "routes": [
        {
          "pattern": "api.mustbeviral.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "SERVICE_NAME": "mustbeviral-core",
        "SERVICE_GENERATION": "viralgraph-cleanroom-v2",
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "mustbeviral-v2-production-media",
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000002",
        },
      ],
    },
  },
}
