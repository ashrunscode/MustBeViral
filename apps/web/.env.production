NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_L06t0Y52MPKmhWtAHXm3FQ_2_b0-lMb
NEXT_PUBLIC_CORE_API_URL=https://mustbeviral-v2-staging-core.ernijs-ansons.workers.dev
