{
	"extends": "./tsconfig.json",
	"include": [
		"*.config.ts",
		"playwright.config.ts",
		"react-router.config.ts",
		"scripts/**/*.ts",
		"src/server/http/envelope.ts",
		"src/server/services/auth/password.ts",
		"src/server/services/entitlements.ts",
		"src/server/services/model-router-gateway.ts",
		"src/server/services/model-router-image.ts",
		"src/server/services/scheduler/index.ts",
		"src/server/services/security/*.ts",
		"src/server/services/stripe/events.ts",
		"src/server/services/stripe/signature.ts",
		"src/server/utils/id.ts",
		"src/server/workflows/params.ts",
		"src/server/workflows/workflow-policy.ts",
		"tests/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts"
	],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"types": ["node"],
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
