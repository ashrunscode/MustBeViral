{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mustbeviral.com/schemas/work-packet.schema.json",
  "title": "MustBeViral active work packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "spec_revision",
    "title",
    "phase",
    "status",
    "priority",
    "branch",
    "objective",
    "authority_refs",
    "required_skills",
    "depends_on",
    "scope",
    "deliverables",
    "public_interfaces",
    "steps",
    "acceptance",
    "quality_gates",
    "rollback",
    "external_effects",
    "handoff",
    "completion"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "spec_revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["R0", "D0", "P0", "P1a", "P1b", "P2", "P3", "P4"] },
    "status": { "enum": ["ready", "in_progress", "blocked", "complete"] },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "branch": { "type": "string", "pattern": "^codex/[a-z0-9][a-z0-9._/-]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
      "uniqueItems": true
    },
    "required_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "required_doc_ids"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "required_doc_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "uniqueItems": true
        }
      }
    },
    "deliverables": { "$ref": "#/$defs/stringOrRecordArray" },
    "public_interfaces": { "$ref": "#/$defs/stringOrRecordArray" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "current", "completed", "blocked"] }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "manual"],
      "properties": {
        "automated": { "$ref": "#/$defs/checkArray" },
        "manual": { "$ref": "#/$defs/checkArray" }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "command": { "type": "string", "pattern": "^pnpm [a-zA-Z0-9:_-]+$" },
          "status": { "enum": ["pending", "passed", "failed"] },
          "evidence": { "$ref": "#/$defs/pathArray" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "remote_actions_required"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "remote_actions_required": { "type": "boolean" }
      }
    },
    "external_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_mutation", "destructive_remote_actions"],
      "properties": {
        "remote_mutation": { "enum": ["none", "read-only", "approval-required", "authorized"] },
        "destructive_remote_actions": { "type": "boolean" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_step", "next_action", "blockers", "changed_paths", "last_green_checks"],
      "properties": {
        "current_step": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "changed_paths": { "$ref": "#/$defs/pathArray" },
        "last_green_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successor_packet_id", "evidence_paths", "completed_at"],
      "properties": {
        "successor_packet_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
        "evidence_paths": { "$ref": "#/$defs/pathArray" },
        "completed_at": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "pathArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "stringOrRecordArray": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean", "null"]
            }
          }
        ]
      }
    },
    "checkArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "passed", "failed", "not_applicable"] },
          "evidence": { "$ref": "#/$defs/pathArray" }
        }
      }
    }
  }
}
