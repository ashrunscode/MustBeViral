{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mustbeviral.com/schemas/design-direction-evidence.schema.json",
  "title": "MustBeViral design direction evidence",
  "oneOf": [{ "$ref": "#/$defs/explorationEvidence" }, { "$ref": "#/$defs/highFidelityEvidence" }],
  "$defs": {
    "schemaVersion": { "const": 1 },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!\\.?$)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "renderedArtifact": {
      "oneOf": [
        { "type": "string", "pattern": "^https://[^\\s]+$" },
        { "$ref": "#/$defs/repoRelativePath" }
      ]
    },
    "highFidelityArtifactPath": {
      "allOf": [
        { "$ref": "#/$defs/repoRelativePath" },
        { "type": "string", "pattern": "^\\.superdesign/hifi/[^/\\\\]+\\.html$" }
      ]
    },
    "pngPath": {
      "allOf": [{ "$ref": "#/$defs/repoRelativePath" }, { "type": "string", "pattern": "\\.png$" }]
    },
    "viewport": {
      "type": "string",
      "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rendered_artifact", "desktop_capture", "shared_content_id"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "rendered_artifact": { "$ref": "#/$defs/renderedArtifact" },
        "desktop_capture": { "$ref": "#/$defs/repoRelativePath" },
        "shared_content_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "focus", "rendered_artifact", "desktop_capture", "shared_content_id"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "focus": {
          "enum": ["calm-density", "canvas-legibility", "review-approval-confidence"]
        },
        "rendered_artifact": { "$ref": "#/$defs/renderedArtifact" },
        "desktop_capture": { "$ref": "#/$defs/repoRelativePath" },
        "shared_content_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "note"],
      "properties": {
        "dimension": { "enum": ["accessibility", "density", "legibility", "responsive"] },
        "status": { "enum": ["pass", "fail", "noted"] },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings"],
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/reviewFinding" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["dimension"],
                "properties": { "dimension": { "const": "accessibility" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["dimension"],
                "properties": { "dimension": { "const": "density" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["dimension"],
                "properties": { "dimension": { "const": "legibility" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["dimension"],
                "properties": { "dimension": { "const": "responsive" } }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "pending" } }
    },
    "blockedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "blocked" } }
    },
    "explorationUserSelectedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "selected_branch", "selected_by", "selected_at", "selection_source"],
      "properties": {
        "state": { "const": "user_selected" },
        "selected_branch": { "$ref": "#/$defs/nonEmptyString" },
        "selected_by": { "$ref": "#/$defs/nonEmptyString" },
        "selected_at": { "$ref": "#/$defs/selectionTimestamp" },
        "selection_source": { "const": "explicit_user_statement" }
      }
    },
    "highFidelityUserSelectedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approved_set", "selected_by", "selected_at", "selection_source"],
      "properties": {
        "state": { "const": "user_selected" },
        "approved_set": { "const": "high-fidelity-golden-set" },
        "selected_by": { "$ref": "#/$defs/nonEmptyString" },
        "selected_at": { "$ref": "#/$defs/selectionTimestamp" },
        "selection_source": { "const": "explicit_user_statement" }
      }
    },
    "selectionTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "explorationApproval": {
      "oneOf": [
        { "$ref": "#/$defs/pendingApproval" },
        { "$ref": "#/$defs/explorationUserSelectedApproval" },
        { "$ref": "#/$defs/blockedApproval" }
      ]
    },
    "highFidelityApproval": {
      "oneOf": [
        { "$ref": "#/$defs/pendingApproval" },
        { "$ref": "#/$defs/highFidelityUserSelectedApproval" },
        { "$ref": "#/$defs/blockedApproval" }
      ]
    },
    "explorationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "packet_id",
        "initial_draft",
        "branches",
        "review",
        "approval"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "packet_id": { "const": "WP-D0-001" },
        "initial_draft": { "$ref": "#/$defs/draft" },
        "branches": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/branch" }
        },
        "review": { "$ref": "#/$defs/review" },
        "approval": { "$ref": "#/$defs/explorationApproval" }
      }
    },
    "highFidelityFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact", "viewport"],
      "properties": {
        "name": {
          "enum": [
            "canvas-desktop",
            "campaign-brief",
            "quote-run",
            "output-comparison",
            "receipt",
            "tablet-review",
            "mobile-review"
          ]
        },
        "artifact": { "$ref": "#/$defs/highFidelityArtifactPath" },
        "desktop_capture": { "$ref": "#/$defs/pngPath" },
        "capture": { "$ref": "#/$defs/pngPath" },
        "viewport": { "$ref": "#/$defs/viewport" }
      },
      "oneOf": [
        { "required": ["desktop_capture"], "not": { "required": ["capture"] } },
        { "required": ["capture"], "not": { "required": ["desktop_capture"] } }
      ]
    },
    "watchItemResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_item", "resolution"],
      "properties": {
        "watch_item": { "$ref": "#/$defs/nonEmptyString" },
        "resolution": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "watchItemResolutions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/watchItemResolution" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["watch_item"],
            "properties": { "watch_item": { "const": "1440px inspector overflow" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["watch_item"],
            "properties": { "watch_item": { "const": "12-node density proof" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["watch_item"],
            "properties": { "watch_item": { "const": "quiet retry styling" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "highFidelityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "packet_id",
        "ratified_direction",
        "flows",
        "watch_item_resolutions",
        "review",
        "approval"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "packet_id": { "const": "WP-D0-002" },
        "ratified_direction": { "const": "Review Approval" },
        "flows": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/highFidelityFlow" }
        },
        "watch_item_resolutions": { "$ref": "#/$defs/watchItemResolutions" },
        "review": { "$ref": "#/$defs/review" },
        "approval": { "$ref": "#/$defs/highFidelityApproval" }
      }
    }
  }
}
