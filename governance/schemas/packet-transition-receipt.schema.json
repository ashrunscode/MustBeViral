{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mustbeviral.com/schemas/packet-transition-receipt.schema.json",
  "title": "MustBeViral completed packet transition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "spec_revision",
    "phase",
    "branch",
    "status",
    "completed_at",
    "successor_packet_id",
    "predecessor_head",
    "closed_packet_path",
    "completion_evidence_paths",
    "evidence_entries",
    "completed_step_ids",
    "closed_packet_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "spec_revision": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["R0", "D0", "P0", "P1a", "P1b", "P2", "P3", "P4"] },
    "branch": { "type": "string", "pattern": "^codex/[a-z0-9][a-z0-9._/-]*$" },
    "status": { "const": "complete" },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "successor_packet_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "predecessor_head": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "closed_packet_path": { "$ref": "#/$defs/relativePath" },
    "completion_evidence_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "evidence_entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "git_blob_oid"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "git_blob_oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
        }
      }
    },
    "completed_step_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" }
    },
    "closed_packet_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}
