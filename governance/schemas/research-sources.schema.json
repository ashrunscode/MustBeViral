{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mustbeviral.com/schemas/research-sources.schema.json",
  "title": "MustBeViral research source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "source_type",
          "valid_as_of",
          "reverify_after",
          "used_by"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "source_type": {
            "enum": [
              "official-docs",
              "primary-source",
              "research-paper",
              "public-product",
              "market-evidence"
            ]
          },
          "valid_as_of": { "$ref": "#/$defs/date" },
          "reverify_after": { "$ref": "#/$defs/date" },
          "used_by": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
