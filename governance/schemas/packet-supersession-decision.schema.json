{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit owner packet supersession decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "authorized_by",
    "authorization_source",
    "authorized_at",
    "authorization_statement",
    "selection_statement",
    "predecessor_packet_id",
    "predecessor_spec_revision",
    "successor_packet_id",
    "successor_spec_revision",
    "branch",
    "source_plan_sha256",
    "reason",
    "carried_release_obligations",
    "external_effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action": {
      "const": "supersede"
    },
    "authorized_by": {
      "const": "repository-owner"
    },
    "authorization_source": {
      "const": "explicit_user_instruction"
    },
    "authorized_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "authorization_statement": {
      "type": "string",
      "minLength": 1
    },
    "selection_statement": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_packet_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "predecessor_spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "successor_packet_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "successor_spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "branch": {
      "type": "string",
      "pattern": "^codex/[a-z0-9][a-z0-9._/-]*$"
    },
    "source_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "carried_release_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_effects": {
      "const": "none"
    }
  }
}
