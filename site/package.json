{
  "name": "mustbeviral-site",
  "private": true,
  "type": "module",
  "description": "The public site for Must Be Viral at mustbeviral.com: static pages and a waitlist form on one Cloudflare Worker with D1.",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && node scripts/check-site.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mustbeviral-site --local",
    "db:migrate:remote": "wrangler d1 migrations apply mustbeviral-site --remote",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.81.0"
  }
}
